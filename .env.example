# Avatar X Configuration\n\n# Database: PostgreSQL\n# Connection string for persistent relational data\nPOSTGRES_URL=postgresql://user:password@localhost:5432/avatar_x\n\n# Database: Neo4j\n# Connection string for knowledge graph database\nNEO4J_URL=bolt://localhost:7687\nNEO4J_USER=neo4j\nNEO4J_PASSWORD=password\n\n# Store Configuration\n# Enable caching layer\nSTORE_CACHE_ENABLED=true\n# Cache TTL in milliseconds\nSTORE_CACHE_TTL=300000\n# Maximum cache size\nSTORE_CACHE_SIZE=10000\n# Enable auto-sync to database\nSTORE_AUTO_SYNC=true\n# Sync interval in milliseconds\nSTORE_SYNC_INTERVAL=30000\n\n# Simulation Configuration\n# Simulation tick rate (ticks per second)\nSIMULATION_TICK_RATE=60\n# Maximum entities in simulation\nSIMULATION_MAX_ENTITIES=1000000\n# Emergence threshold (0-1)\nSIMULATION_EMERGENCE_THRESHOLD=0.7\n\n# Logging\n# Log level: debug, info, warn, error\nLOG_LEVEL=info\n\n# Environment\n# development, production, test\nNODE_ENV=development\n"